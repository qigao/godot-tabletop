"value": 2
},
"id": "bid_2",
"label": "Bid 2",
"selection_field": "",
"when": {
"eq": [{
"get": "observation.phase"
}, "bidding"]
}
}, {
"browse": false,
"command": {
"type": "bid",
"value": 3
},
"id": "bid_3",
"label": "Bid 3",
"selection_field": "",
"when": {
"eq": [{
"get": "observation.phase"
}, "bidding"]
}
}, {
"browse": false,
"command": {
"type": "play"
},
"id": "play",
"label": "Play selected",
"selection_field": "cards",
"when": {
"eq": [{
"get": "observation.phase"
}, "playing"]
}
}, {
"browse": false,
"command": {
"type": "pass"
},
"id": "pass",
"label": "Pass",
"selection_field": "",
"when": {
"eq": [{
"get": "observation.phase"
}, "playing"]
}
}, {
"browse": true,
"command": {
"type": "play"
},
"id": "browse",
"label": "Next legal play",
"selection_field": "cards",
"when": {
"eq": [{
"get": "observation.phase"
}, "playing"]
}
}])
selection_equivalence = "group"
interaction = SubResource("Resource_abmju")
motion = SubResource("Resource_h2ymi")
seat_anchors = PackedVector2Array(0.12, 0.82, 0.88, 0.22, 0.12, 0.22)
count_binding = {
"at": [{
"get": "observation.hand_counts"
}, {
"get": "seat"
}]
}
role_binding = {
"if": [{
"eq": [{
"get": "observation.phase"
}, "bidding"]
}, "Bidding", {
"if": [{
"eq": [{
"get": "observation.landlord"
}, {
"get": "seat"
}]
}, "LANDLORD", "FARMER"]
}]
}
public_zones = Array[Dictionary]([{
"anchor": Vector2(0.5, 0.12),
"caption": "Bottom",
"card_size": Vector2(30, 46),
"cards": {
"get": "observation.bottom"
},
"hidden_count": {
"if": [{
"eq": [{
"get": "observation.phase"
}, "bidding"]
}, 3, 0]
},
"id": "bottom",
"size": Vector2(160, 68)
}, {
"anchor": Vector2(0.5, 0.7),
"caption": {
"if": [{
"empty": {
